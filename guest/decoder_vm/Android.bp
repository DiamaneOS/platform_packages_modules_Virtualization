// DiamaneOS: the decode service's VM (packages/apps/DiamaneOSSanitizer, docs/virt-apex.md there): its guest kernel,
// signed over its initramfs like Microdroid's, and the initramfs, both in the virt APEX. The kernel is the DiamaneOS
// guest kernel the filesystem VM uses too (diamaneos_guest_kernel_prebuilt, guest/diamaneos on fs-in-vm), the
// initramfs the decode service's own (decoder_vm_initrd).

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// No debuggable variant: the same initramfs stands for both descriptors pvmfw knows.
avb_gen_vbmeta_image {
    name: "decoder_vm_initrd_normal_hashdesc",
    defaults: ["microdroid_initrd_normal_defaults"],
    src: ":decoder_vm_initrd",
}

avb_gen_vbmeta_image {
    name: "decoder_vm_initrd_debug_hashdesc",
    defaults: ["microdroid_initrd_debug_defaults"],
    src: ":decoder_vm_initrd",
}

avb_add_hash_footer {
    name: "decoder_vm_kernel_signed",
    defaults: ["microdroid_kernel_signed_defaults"],
    filename: "decoder_vm_kernel",
    arch: {
        arm64: {
            src: ":diamaneos_guest_kernel_prebuilt",
        },
    },
    include_descriptors_from_images: [
        ":decoder_vm_initrd_normal_hashdesc",
        ":decoder_vm_initrd_debug_hashdesc",
    ],
}

prebuilt_etc {
    name: "decoder_vm_kernel",
    src: ":empty_file",
    relative_install_path: "fs",
    filename: "decoder_vm_kernel",
    arch: {
        arm64: {
            src: ":decoder_vm_kernel_signed",
        },
    },
}

prebuilt_etc {
    name: "decoder_vm_initrd_apex",
    src: ":decoder_vm_initrd",
    filename: "decoder_vm_initrd.img",
}
