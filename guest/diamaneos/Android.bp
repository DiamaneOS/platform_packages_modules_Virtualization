// DiamaneOS guest kernel: kernel_common-6.18 with microdroid_defconfig plus seccomp, FAT, exFAT and MBR and GPT
// partitions, without modules, and without what neither the filesystem VM nor the decode service VM uses
// (Microdroid's storage, crash kernels, tracing, perf and debugfs), every hardening option kept
// (kernel/guest.config, the full config). It boots the DiamaneOS VMs, each signed together with its own initramfs
// the way Microdroid's kernel is.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

filegroup {
    name: "diamaneos_guest_kernel_prebuilt",
    srcs: ["kernel/arm64/Image"],
}

// The filesystem VM (vendor/diamaneos/fsvm). It has no debuggable variant, so the same initramfs stands for both
// descriptors pvmfw knows.
avb_gen_vbmeta_image {
    name: "fsvm_initrd_normal_hashdesc",
    defaults: ["microdroid_initrd_normal_defaults"],
    src: ":fsvm_guest_initrd",
}

avb_gen_vbmeta_image {
    name: "fsvm_initrd_debug_hashdesc",
    defaults: ["microdroid_initrd_debug_defaults"],
    src: ":fsvm_guest_initrd",
}

avb_add_hash_footer {
    name: "fsvm_kernel_signed",
    defaults: ["microdroid_kernel_signed_defaults"],
    filename: "fsvm_kernel",
    arch: {
        arm64: {
            src: ":diamaneos_guest_kernel_prebuilt",
        },
    },
    include_descriptors_from_images: [
        ":fsvm_initrd_normal_hashdesc",
        ":fsvm_initrd_debug_hashdesc",
    ],
}

prebuilt_etc {
    name: "fsvm_kernel",
    src: ":empty_file",
    relative_install_path: "fs",
    filename: "fsvm_kernel",
    arch: {
        arm64: {
            src: ":fsvm_kernel_signed",
        },
    },
}

prebuilt_etc {
    name: "fsvm_initrd",
    src: ":fsvm_guest_initrd",
    filename: "fsvm_initrd.img",
}
