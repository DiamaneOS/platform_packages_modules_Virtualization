package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_defaults {
    name: "virtualizationmanager_defaults",
    crate_name: "virtualizationmanager",
    crate_root: "src/main.rs",
    defaults: [
        "avf_build_flags_rust",
        "secretkeeper_use_latest_hal_aidl_rust",
        "authgraph_use_latest_hal_aidl_rust",
    ],
    edition: "2021",
    // Only build on targets which crosvm builds on.
    enabled: false,
    target: {
        android64: {
            compile_multilib: "64",
            enabled: true,
        },
        linux_bionic_arm64: {
            enabled: true,
        },
    },
    prefer_rlib: true,
    rustlibs: [
        "android.frameworks.stats-V2-rust",
        "android.hardware.virtualization.capabilities.capabilities_service-V1-rust",
        "android.system.virtualizationcommon-rust",
        "android.system.virtualizationservice-rust",
        "android.system.virtualizationservice_internal-rust",
        "android.system.virtualmachineservice-rust",
        "android.os.permissions_aidl-rust",
        "libavf_aconfig_flags_rust",
        "libandroid_logger",
        "libanyhow",
        "libapkverify",
        "libavf_features",
        "libavflog",
        "libbinder_rs",
        "libcfg_if",
        "libclap",
        "libcrosvm_control_static",
        "libcommand_fds",
        "libdisk",
        "libdm_rust",
        "libdropbox_rs",
        "libglob",
        "libhex",
        "libhypervisor_props",
        "liblibc",
        "liblog_rust",
        "libmicrodroid_metadata",
        "libmicrodroid_payload_config",
        "libhw_timeout_multiplier",
        "libnix",
        "libonce_cell",
        "libpsi_rs",
        "libregex",
        "librpcbinder_rs",
        "librustutils",
        "libsemver",
        "libselinux_bindgen",
        "libserde",
        "libserde_json",
        "libserde_xml_rs",
        "libshared_child",
        "libstatslog_virtualization_rust",
        "libtombstoned_client_rust",
        "libvbmeta_rust",
        "libvmconfig",
        "libzip",
        "libvsock",
        "liblibfdt",
        "libfsfdt",
        "libhypervisor_props",
        "libzerocopy",
        "libuuid",
        "libscopeguard",
        // TODO(b/202115393) stabilize the interface
        "packagemanager_aidl-rust",
        "rpc_servicemanager_aidl-rust",
    ],
    shared_libs: [
        "libselinux",
    ],
    srcs: [":security_vm_instance_id"],
}

rust_binary {
    name: "virtmgr",
    defaults: ["virtualizationmanager_defaults"],
    apex_available: ["com.android.virt"],
}

rust_binary {
    name: "early_virtmgr",
    defaults: ["virtualizationmanager_defaults"],
    srcs: ["src/main.rs"],
    cfgs: ["early"],
    apex_available: ["com.android.virt"],
}

xsd_config {
    name: "early_vms",
    srcs: ["early_vms.xsd"],
    api_dir: "schema",
    package_name: "android.system.virtualizationservice",
}

rust_test {
    name: "virtualizationmanager_device_test",
    srcs: ["src/main.rs"],
    defaults: ["virtualizationmanager_defaults"],
    rustlibs: [
        "libtempfile",
    ],
    data: [
        ":test_avf_debug_policy_with_ramdump",
        ":test_avf_debug_policy_without_ramdump",
        ":test_avf_debug_policy_with_adb",
        ":test_avf_debug_policy_without_adb",
        ":test_avf_reference_dt_fs",
    ],
    test_suites: ["general-tests"],
}

// DiamaneOS: what the filesystem VM's hosts may ask for (src/fsvm_client.rs).
rust_test_host {
    name: "virtmgr_fsvm_client_test",
    crate_name: "virtmgr_fsvm_client_test",
    srcs: ["src/fsvm_client.rs"],
    edition: "2021",
    test_suites: ["general-tests"],
}

// DiamaneOS: the reader of a guest's console and log output, its bounds and its rate
// (src/guest_log.rs).
rust_test_host {
    name: "virtmgr_guest_log_test",
    crate_name: "virtmgr_guest_log_test",
    srcs: ["src/guest_log.rs"],
    edition: "2021",
    test_suites: ["general-tests"],
}

// DiamaneOS: the VM manager's seccomp filter, what it decides, evaluated as the kernel would
// (src/seccomp.rs).
rust_test_host {
    name: "virtmgr_seccomp_test",
    crate_name: "virtmgr_seccomp_test",
    srcs: ["src/seccomp.rs"],
    edition: "2021",
    rustlibs: [
        "libanyhow",
        "liblibc",
        "liblog_rust",
    ],
    test_suites: ["general-tests"],
}

// DiamaneOS: the real private-instance helpers with an AIDL shape that cannot be cloned.
rust_test_host {
    name: "virtmgr_fsvm_instance_test",
    crate_name: "virtmgr_fsvm_instance_test",
    srcs: ["tests/fsvm_instance_host_test.rs"],
    edition: "2021",
    test_suites: ["general-tests"],
}

// DiamaneOS child launch and observed-exit receipts use the same source on the host and device.
rust_test_host {
    name: "virtmgr_launch_evidence_test",
    crate_name: "virtmgr_launch_evidence_test",
    srcs: ["src/launch_evidence.rs"],
    test_suites: ["general-tests"],
}

// DiamaneOS release-build refusal of the decoder launch test marker.
rust_test_host {
    name: "virtmgr_launch_debug_test",
    crate_name: "virtmgr_launch_debug_test",
    srcs: ["src/launch_debug.rs"],
    test_suites: ["general-tests"],
}

// DiamaneOS no-child cleanup uses the optional internal-service contract in the actual helper.
rust_test_host {
    name: "virtmgr_launch_cleanup_test",
    crate_name: "virtmgr_launch_cleanup_test",
    srcs: ["tests/launch_cleanup_host_test.rs"],
    edition: "2021",
    test_suites: ["general-tests"],
}

// DiamaneOS compile the actual early receipt without test-only retirement uses.
rust_binary_host {
    name: "virtmgr_launch_evidence_early_check",
    srcs: ["tests/launch_evidence_early_check.rs"],
    cfgs: ["early"],
    flags: ["-Dwarnings"],
    edition: "2021",
}
